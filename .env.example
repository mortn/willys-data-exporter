# Copy this file to .env and fill in your Willys credentials.
# The exporter uses the password login method, not Mobilt BankID.
# These variables are used by the default profile (when --profile is omitted).
WILLYS_USERNAME=
WILLYS_PASSWORD=

# Named profiles use separate output directories. Add only the profiles you need.
WILLYS_USER1_USERNAME=
WILLYS_USER1_PASSWORD=
WILLYS_USER2_USERNAME=
WILLYS_USER2_PASSWORD=
